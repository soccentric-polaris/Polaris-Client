[Unit]
Description=Polaris Client — gRPC daemon for IV&V hardware validation
Documentation=https://github.com/SiliconCentric/Polaris-Client
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=polaris
Group=polaris
WorkingDirectory=/var/lib/polaris
# Starts BOTH listeners:
#   - ClientService (stream path → Server, default port 50051)
#   - HalService    (SDK/E2E path,          default port 50052)
ExecStart=/usr/bin/polaris-client
Restart=on-failure
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=polaris-client

# Hardening
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
ReadWritePaths=/var/lib/polaris
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
